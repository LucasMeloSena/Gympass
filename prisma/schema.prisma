generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password_hash String
  phone         String         @unique
  role          Role           @default(MEMBER)
  created_at    DateTime       @default(now())
  checkIns      CheckIn[]
  Payment       Payment[]
  Subscription  Subscription[]

  @@map("users")
}

model Gym {
  id              String    @id @default(uuid())
  name            String
  image           String
  description     String?
  email           String    @unique
  phone           String?
  latitude        Decimal
  longitude       Decimal
  state           String
  city            String
  district        String
  street          String
  adress_number   String
  adress_addition String?
  checkIns        CheckIn[]

  @@map("gyms")
}

model CheckIn {
  id           String    @id @default(uuid())
  created_at   DateTime  @default(now())
  validated_at DateTime?

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  gym    Gym    @relation(fields: [gym_id], references: [id])
  gym_id String

  @@map("check_ins")
}

enum PaymentStatus {
  PENDING
  SUCCESSED
  FAILED
  CANCELED
}

model Payment {
  id         String        @id @default(uuid())
  payment_id String        @unique
  amount     Int
  status     PaymentStatus
  created_at DateTime      @default(now())

  subscription    Subscription? @relation(fields: [subscription_id], references: [id])
  subscription_id String?

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  @@map("payments")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
}

model Subscription {
  id         String             @id @default(uuid())
  status     SubscriptionStatus
  created_at DateTime           @default(now())

  user    User   @relation(fields: [user_id], references: [id])
  user_id String @unique

  payments Payment[]

  @@map("subscriptions")
}
